{
  "name": "springboot-generator-cli",
  "version": "1.0.0",
  "description": "An AI-friendly, compile-safe Spring Boot scaffolding core with DDD-friendly defaults",
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "sg": "dist/cli.js"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "dev": "tsc --watch -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest",
    "smoke:maven": "node scripts/smoke-generate.mjs",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "springboot",
    "cli",
    "generator",
    "scaffold",
    "java",
    "ddd",
    "modulith",
    "codex",
    "skills",
    "agent",
    "skills.sh"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YIbaikaishui/springboot-generator-cli.git"
  },
  "homepage": "https://github.com/YIbaikaishui/springboot-generator-cli#readme",
  "bugs": {
    "url": "https://github.com/YIbaikaishui/springboot-generator-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "templates"
  ],
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "ejs": "^3.1.9",
    "figlet": "^1.7.0",
    "inquirer": "^9.2.15",
    "ora": "^7.0.1",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/figlet": "^1.5.8",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
