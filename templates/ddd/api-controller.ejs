package <%= packageName %>;

import <%= applicationPackage %>.<%= applicationServiceName %>;
import <%= apiPackage %>.<%= createRequestClassName %>;
import <%= apiPackage %>.<%= updateRequestClassName %>;
import <%= apiPackage %>.<%= responseClassName %>;
import jakarta.validation.Valid;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import java.util.List;

@RestController
@RequestMapping("/api/<%= routeName %>")
public class <%= className %> {

    private final <%= applicationServiceName %> <%= classNameCamel %>ApplicationService;

    public <%= className %>(<%= applicationServiceName %> <%= classNameCamel %>ApplicationService) {
        this.<%= classNameCamel %>ApplicationService = <%= classNameCamel %>ApplicationService;
    }

    @PostMapping
    public ResponseEntity<<%= responseClassName %>> create(
            @Valid @RequestBody <%= createRequestClassName %> request
    ) {
        return ResponseEntity.status(HttpStatus.CREATED)
                .body(<%= classNameCamel %>ApplicationService.create(request));
    }

    @GetMapping("/{id}")
    public ResponseEntity<<%= responseClassName %>> getById(@PathVariable Long id) {
        return ResponseEntity.ok(<%= classNameCamel %>ApplicationService.getById(id));
    }

    @GetMapping
    public ResponseEntity<List<<%= responseClassName %>>> getAll() {
        return ResponseEntity.ok(<%= classNameCamel %>ApplicationService.getAll());
    }

    @PutMapping("/{id}")
    public ResponseEntity<<%= responseClassName %>> update(
            @PathVariable Long id,
            @Valid @RequestBody <%= updateRequestClassName %> request
    ) {
        return ResponseEntity.ok(<%= classNameCamel %>ApplicationService.update(id, request));
    }

    @DeleteMapping("/{id}")
    public ResponseEntity<Void> delete(@PathVariable Long id) {
        <%= classNameCamel %>ApplicationService.delete(id);
        return ResponseEntity.noContent().build();
    }
}
