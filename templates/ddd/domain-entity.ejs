package <%= packageName %>;

<% (imports ?? []).forEach((importPath) => { -%>
import <%= importPath %>;
<% }) -%>

public class <%= className %> {

<% (fields ?? []).forEach((field) => { -%>
    private <%= field.type %> <%= field.name %>;
<% }) -%>

    public <%= className %>() {
    }

    public <%= className %>(
<% (fields ?? []).forEach((field, index, list) => { -%>
            <%= field.type %> <%= field.name %><%= index < list.length - 1 ? ',' : '' %>
<% }) -%>
    ) {
<% (fields ?? []).forEach((field) => { -%>
        this.<%= field.name %> = <%= field.name %>;
<% }) -%>
    }

    public static <%= className %> create(
<% (businessFields ?? []).forEach((field, index, list) => { -%>
            <%= field.type %> <%= field.name %><%= index < list.length - 1 ? ',' : '' %>
<% }) -%>
    ) {
        LocalDateTime now = LocalDateTime.now();
        return new <%= className %>(
                null,
<% (businessFields ?? []).forEach((field) => { -%>
                <%- field.isString ? `requireValue(${field.name}, "${field.name}")` : field.name %>,
<% }) -%>
                now,
                now
        );
    }

    public void update(
<% (businessFields ?? []).forEach((field, index, list) => { -%>
            <%= field.type %> <%= field.name %><%= index < list.length - 1 ? ',' : '' %>
<% }) -%>
    ) {
<% (businessFields ?? []).forEach((field) => { -%>
        this.<%= field.name %> = <%- field.isString ? `requireValue(${field.name}, "${field.name}")` : field.name %>;
<% }) -%>
        this.updatedAt = LocalDateTime.now();
    }

<% (fields ?? []).forEach((field) => { -%>
    public <%= field.type %> <%= field.getterName %>() {
        return <%= field.name %>;
    }

    public void <%= field.setterName %>(<%= field.type %> <%= field.name %>) {
        this.<%= field.name %> = <%- field.isString ? `requireValue(${field.name}, "${field.name}")` : field.name %>;
    }

<% }) -%>
<% if ((businessFields ?? []).some((field) => field.isString)) { -%>
    private static String requireValue(String value, String fieldName) {
        String normalized = Objects.requireNonNull(value, fieldName + " must not be null").trim();
        if (normalized.isEmpty()) {
            throw new IllegalArgumentException(fieldName + " must not be blank");
        }
        return normalized;
    }
<% } -%>
}
