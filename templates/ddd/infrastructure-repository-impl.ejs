package <%= packageName %>;

import <%= domainPackage %>.<%= entityName %>;
import <%= domainPackage %>.<%= repositoryInterfaceName %>;
import org.springframework.stereotype.Repository;
<% (imports ?? []).forEach((importPath) => { -%>
import <%= importPath %>;
<% }) -%>
import java.util.List;
import java.util.Optional;
import java.util.stream.Collectors;

@Repository
public class <%= className %> implements <%= repositoryInterfaceName %> {

    private final <%= jpaRepositoryName %> <%= entityNameLower %>JpaRepository;

    public <%= className %>(<%= jpaRepositoryName %> <%= entityNameLower %>JpaRepository) {
        this.<%= entityNameLower %>JpaRepository = <%= entityNameLower %>JpaRepository;
    }

    @Override
    public Optional<<%= entityName %>> findById(Long id) {
        return <%= entityNameLower %>JpaRepository.findById(id).map(this::toDomain);
    }

    @Override
    public List<<%= entityName %>> findAll() {
        return <%= entityNameLower %>JpaRepository.findAll().stream()
                .map(this::toDomain)
                .collect(Collectors.toList());
    }

    @Override
    public <%= entityName %> save(<%= entityName %> <%= entityNameLower %>) {
        <%= jpaEntityName %> saved = <%= entityNameLower %>JpaRepository.save(toJpaEntity(<%= entityNameLower %>));
        return toDomain(saved);
    }

    @Override
    public void deleteById(Long id) {
        <%= entityNameLower %>JpaRepository.deleteById(id);
    }

    private <%= entityName %> toDomain(<%= jpaEntityName %> entity) {
        return new <%= entityName %>(
<% (fields ?? []).forEach((field, index, list) => { -%>
                entity.<%= field.getterName %>()<%= index < list.length - 1 ? ',' : '' %>
<% }) -%>
        );
    }

    private <%= jpaEntityName %> toJpaEntity(<%= entityName %> <%= entityNameLower %>) {
        <%= jpaEntityName %> entity = new <%= jpaEntityName %>();
<% (fields ?? []).forEach((field) => { -%>
<% if (field.isAudit) { -%>
        entity.<%= field.setterName %>(defaultTimestamp(<%= entityNameLower %>.<%= field.getterName %>()));
<% } else { -%>
        entity.<%= field.setterName %>(<%= entityNameLower %>.<%= field.getterName %>());
<% } -%>
<% }) -%>
        return entity;
    }

    private LocalDateTime defaultTimestamp(LocalDateTime value) {
        return value == null ? LocalDateTime.now() : value;
    }
}
