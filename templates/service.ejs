package <%= packageName %>;

import <%= dtoPackage %>.<%= requestClassName %>;
import <%= dtoPackage %>.<%= responseClassName %>;
<% if (hasJpa) { %>
import org.springframework.data.domain.Page;
import org.springframework.data.domain.Pageable;<% } %>

import java.util.List;

public interface <%= className %> {

    <%= responseClassName %> create(<%= requestClassName %> request);

    <%= responseClassName %> getById(Long id);

    List<<%= responseClassName %>> getAll();

    <% if (hasJpa) { %>
    Page<<%= responseClassName %>> getPage(Pageable pageable);
    <% } %>

    <%= responseClassName %> update(Long id, <%= requestClassName %> request);

    void delete(Long id);
}
